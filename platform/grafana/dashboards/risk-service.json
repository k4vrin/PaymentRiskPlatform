{
  "uid": "payment-risk-risk-service",
  "title": "Payment Risk - Risk Service",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Risk Service Latency p95",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(paymentrisk_risk_service_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Risk Failures",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(paymentrisk_risk_service_timeouts_total[5m])", "legendFormat": "timeouts" },
        { "expr": "rate(paymentrisk_risk_service_unavailable_total[5m])", "legendFormat": "unavailable" }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    }
  ]
}
